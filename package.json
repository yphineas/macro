{
  "name": "electron-react-starter",
  "version": "1.0.0",
  "private": true,
  "main": "src/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -c \"auto\" -n vite,electron -s first \"npm run vite\" \"npx wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "vite": "vite",
    "build:react": "vite build",
    "build": "npm run build:react",
    "start": "electron ."
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.5.1",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
